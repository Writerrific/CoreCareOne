# CoreCareOne configuration
#
# The prototype runs fully WITHOUT any key using a deterministic offline engine
# (great for demos and for keeping PHI off third-party services during dev).
#
# Provide an Anthropic API key to enable the LLM-powered natural-language layer
# (situation understanding + empathetic phrasing + narrative brief writing).
# The CLINICAL logic — instruments, scoring, risk tiers — is deterministic either way.

ANTHROPIC_API_KEY=

# Model to use for the natural-language layer.
CORECARE_MODEL=claude-opus-4-8

# Set to "mock" to force the offline engine even when a key is present.
# Set to "auto" (default) to use the LLM when a key is available.
CORECARE_ENGINE=auto
